# Copy to .env and fill in values. Never commit .env (it is gitignored).

# Which provider POST /chat uses: gemini | groq
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free tier is per model; the lite model has a far larger daily allowance than
# the flagship flash models (which allow only ~20 requests/day on a free key).
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Seconds to wait for a completion before giving up
LLM_TIMEOUT_SECONDS=30

# SQLite file. Default: the per-user app-data folder
#   macOS   ~/Library/Application Support/PersonalAIAssistant/assistant.db
#   Linux   ~/.local/share/PersonalAIAssistant/assistant.db
#   Windows %LOCALAPPDATA%\PersonalAIAssistant\assistant.db
# Uncomment to keep a throwaway dev database next to the code instead
# (relative paths are resolved against backend/; *.db is gitignored):
# DATABASE_PATH=./data/dev.db
